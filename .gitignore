# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Ss]witchIL2CPPCache/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.idea/
.codex/
.claude/
.utmp/
.DS_Store

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Portfolio source snapshot: keep authored systems and lightweight scene data;
# omit licensed vehicles, tracks, SDK copies, baked data, and art packs.
/Assets/*
!/Assets/_Scripts/
!/Assets/_Scripts/**
!/Assets/_Scripts.meta
!/Assets/Script/
!/Assets/Script/**
!/Assets/Script.meta
!/Assets/Scripts/
!/Assets/Scripts/**
!/Assets/Scripts.meta
!/Assets/ScriptableObjects/
!/Assets/ScriptableObjects/**
!/Assets/ScriptableObjects.meta
!/Assets/Scenes/
!/Assets/Scenes/**
!/Assets/Scenes.meta
!/Assets/Settings/
!/Assets/Settings/**
!/Assets/Settings.meta
!/Assets/Shader/
!/Assets/Shader/**
!/Assets/Shader.meta
!/Assets/Shaders/
!/Assets/Shaders/**
!/Assets/Shaders.meta
!/Assets/Prefabs/
!/Assets/Prefabs/**
!/Assets/Prefabs.meta
!/Assets/Resources/
!/Assets/Resources/**
!/Assets/Resources.meta
!/Assets/CarPaint.shadergraph
!/Assets/CarPaint.shadergraph.meta
!/Assets/Hologram.shadergraph
!/Assets/Hologram.shadergraph.meta
!/Assets/DefaultVolumeProfile.asset
!/Assets/DefaultVolumeProfile.asset.meta
!/Assets/UniversalRenderPipelineGlobalSettings.asset
!/Assets/UniversalRenderPipelineGlobalSettings.asset.meta
/TempGhidraCarX/
/Backups/
